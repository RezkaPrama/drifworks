# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Midtrans (server-side only, never expose to the browser) ---
# Sandbox keys start with SB-Mid-server- / SB-Mid-client-. Switch to production keys when going live.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
# false = sandbox, true = production
MIDTRANS_IS_PRODUCTION="false"

# --- Firebase Admin (server-side only) ---
FIREBASE_PROJECT_ID="gen-lang-client-0079102908"
FIRESTORE_DATABASE_ID="ai-studio-6a13bc1a-7c20-4ca7-8ea3-971646edc255"
# Path to the service account JSON on the VPS (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS="/etc/driftworks/service-account.json"

# Port the Express server listens on behind the reverse proxy (nginx/caddy)
PORT="3001"
